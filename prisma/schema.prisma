generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("Role")
}

model User {
  userId               Int             @id @default(autoincrement())
  title                String?         @db.VarChar(50)
  firstName            String?         @db.VarChar(255)
  lastName             String?         @db.VarChar(255)
  email                String          @unique @db.VarChar(100)
  phone                String?         @db.VarChar(15)
  password             String?         @db.VarChar(255)
  otp                  Int?
  isLTSI               String?         @db.VarChar(50)
  LTSINumber           String?         @db.VarChar(100)
  medicalCouncilNumber String?         @db.VarChar(100)
  specialityDepartment String?         @db.VarChar(255)
  gender               String?         @db.VarChar(50)
  city                 String?         @db.VarChar(100)
  country              String?         @db.VarChar(100)
  address              String?         @db.VarChar(255)
  status               Int
  createdOn            DateTime        @default(now()) @db.Timestamp(0)
  otpExpiry            DateTime?       @db.DateTime(0)
  role                 Int             @default(3)
  add_role             Int?            @default(0)
  lastLogin            DateTime?
  token                String?         @db.VarChar(1000)
  profileImage         String?         @db.VarChar(1000)
  andLogin             Int?            @default(0)
  fcmAndToken          String?         @db.VarChar(1000)
  fcmIosToken          String?         @db.VarChar(1000)
  iosLogin             Int?            @default(0)
  absSubmissions       AbsSubmission[]
  bookingDetails       BookingDetail[]
  bookings             Booking[]
  employments          Employment[]
  roleId               Role?           @relation(fields: [role], references: [id], map: "fk_users_roleId")

  @@index([status])
  @@index([role])
  @@index([lastName, firstName])
  @@map("users")
}

model WorkShop {
  workShopId Int      @id @default(autoincrement())
  workShop   String   @db.VarChar(255)
  fee        Int
  sequence   Int
  status     Int
  createdOn  DateTime @default(now()) @db.Timestamp(0)
  link       String?  @db.VarChar(500)

  @@index([status])
  @@index([sequence])
  @@map("workShop")
}

model Title {
  title_id Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  sequence Int
  status   Int

  @@index([status])
  @@index([sequence])
  @@map("title")
}

model SpecialityDepartment {
  departmentId             Int      @id @default(autoincrement())
  specialityDepartmentName String   @db.VarChar(255)
  sequence                 Int
  status                   Int
  createdOn                DateTime @default(now()) @db.Timestamp(0)

  @@index([status])
  @@index([sequence])
  @@map("specialityDepartment")
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  type           String?  @db.VarChar(255)
  typeId         String?  @db.VarChar(255)
  title          String?  @db.VarChar(255)
  message        String?  @db.Text
  htmlMessage    String?  @db.Text
  image          String?  @db.Text
  toId           Int?
  totalCount     Int?     @default(0)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamp(0)
  senderId       Int?

  @@index([toId])
  @@index([status])
  @@map("lft_notification")
}

model Event {
  dayNo         String          @db.VarChar(100)
  eventDate     DateTime
  filter        String          @db.Text
  title         String          @db.VarChar(500)
  dateRange     String          @db.VarChar(500)
  venue         String          @db.VarChar(500)
  noOfPeople    Int
  isLive        Int             @default(0)
  eventId       Int             @id @default(autoincrement())
  speakerName   String          @db.Text
  overview      String?         @db.Text
  longdesc      String?         @db.Text
  banner        String?         @db.VarChar(500)
  chairpersons  String?         @db.Text
  filter2       String?         @db.Text
  panelists     String?         @db.Text
  sequence      String?         @db.Text
  theme         String?         @db.Text
  moderatorName String?         @db.Text
  sessions      ChooseSession[]
  eventDetail   EventDetail[]

  @@index([eventDate])
  @@map("events")
}

model EventDetail {
  eventDetailId Int     @id @default(autoincrement())
  eventId       Int
  startTime     String  @db.VarChar(100)
  endTime       String  @db.VarChar(100)
  genre         String? @db.VarChar(100)
  topic         String? @db.Text
  speaker       String? @db.Text
  panelists     String? @db.Text
  moderator     String? @db.Text
  event         Event   @relation(fields: [eventId], references: [eventId], map: "eventDetail_eventId_fkey")

  @@index([eventId], map: "eventDetail_eventId_fkey")
  @@map("eventDetail")
}

model ChooseSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [eventId])

  @@index([eventId], map: "chooseSession_eventId_fkey")
  @@map("chooseSession")
}

model Employment {
  employmentId    Int      @id @default(autoincrement())
  userId          Int
  designation     String   @db.VarChar(255)
  hospitalName    String   @db.VarChar(255)
  hospitalAddress String   @db.Text
  createdOn       DateTime @default(now()) @db.Timestamp(0)
  user            User     @relation(fields: [userId], references: [userId], map: "fk_employment_user")

  @@index([userId])
  @@index([createdOn])
  @@map("employment")
}

model ConferenceFees {
  conferenceId Int      @id @default(autoincrement())
  memberType   String   @db.VarChar(255)
  fee          Int
  sequence     Int
  status       Int
  createdOn    DateTime @default(now()) @db.Timestamp(0)

  @@index([status])
  @@index([sequence])
  @@index([memberType])
  @@map("conferenceFees")
}

model Booking {
  bookingId              Int             @id @default(autoincrement())
  bookingNumber          String          @db.VarChar(255)
  userId                 Int
  memberType             String?         @db.VarChar(255)
  memberTypeFee          String?         @default("0") @db.VarChar(11)
  accompanyingPersonName String?         @db.VarChar(255)
  accompanyingPersonfee  String?         @default("0") @db.VarChar(50)
  accommodation          String?         @db.VarChar(255)
  accommodationFee       String?         @default("0") @db.VarChar(11)
  checkin                String?         @db.VarChar(100)
  checkout               String?         @db.VarChar(100)
  nights                 String          @default("0") @db.VarChar(11)
  totalPayment           Int?            @default(0)
  status                 Int             @default(0)
  createdOn              DateTime        @default(now()) @db.Timestamp(0)
  updatedOn              DateTime?       @db.Timestamp(0)
  screenShot             String?         @db.Text
  bookingFrom            Int             @default(2) // 1 for App , 2 for Website 
  bookingDetails         BookingDetail[]
  user                   User            @relation(fields: [userId], references: [userId], map: "fk_bookings_user")

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model BookingDetail {
  bookingDetailId Int     @id @default(autoincrement())
  bookingId       Int
  userId          Int
  workshop        String? @db.VarChar(255)
  workshopFee     Int?
  booking         Booking @relation(fields: [bookingId], references: [bookingId], map: "fk_bookingDetail_booking")
  user            User    @relation(fields: [userId], references: [userId], map: "fk_bookingDetail_user")

  @@index([bookingId])
  @@index([userId])
  @@map("bookingDetail")
}

model AccommodationCharges {
  accommodationId   Int      @id @default(autoincrement())
  accommodationType String   @db.VarChar(255)
  charge            String   @db.VarChar(255)
  price             String?  @db.VarChar(255)
  sequence          Int
  status            Int
  createdOn         DateTime @default(now()) @db.Timestamp(0)

  @@index([status])
  @@index([sequence])
  @@index([accommodationType])
  @@map("accommodationCharges")
}

model AbsTheme {
  themeId   Int    @id @default(autoincrement())
  themeName String @db.VarChar(255)
  status    Int    @default(1)
  sequence  Int    @default(0)

  @@index([status])
  @@index([sequence])
  @@map("abs_theme")
}

model AbsSubmission {
  submissionId         Int         @id @default(autoincrement())
  userId               Int?
  abstractSubmissionId String?     @db.VarChar(255)
  categoryId           String      @db.VarChar(200)
  subCategoryId        String?     @db.VarChar(255)
  themeName            String?     @db.VarChar(255)
  abstractTitle        String      @db.VarChar(255)
  abstractDetail       String?     @db.LongText
  keywords             String?     @db.Text
  video                String?     @db.VarChar(255)
  filedoc              String?     @db.VarChar(255)
  IsConflictofInterest Int?        @default(0)
  message              String?     @db.Text
  status               Int?        @default(0)
  createdOn            DateTime    @default(now()) @db.DateTime(0)
  submissionStatus     String?     @db.VarChar(5)
  abstractFile         String?     @db.VarChar(255)
  rating               Float?
  authors              AbsAuthor[]
  user                 User?       @relation(fields: [userId], references: [userId], map: "fk_abs_submission_user")

  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@map("abs_submission")
}

model AbsSubCategory {
  subId       Int         @id @default(autoincrement())
  catId       Int
  subCategory String      @db.VarChar(255)
  status      Int         @default(1)
  sequence    Int         @default(0)
  category    AbsCategory @relation(fields: [catId], references: [id], map: "fk_abs_subcategory_category")

  @@index([catId])
  @@index([status])
  @@index([sequence])
  @@map("abs_subcategory")
}

model AbsCategory {
  id            Int              @id @default(autoincrement())
  category      String           @db.VarChar(255)
  status        Int              @default(1)
  sequence      Int              @default(0)
  createdOn     DateTime         @default(now()) @db.DateTime(0)
  subcategories AbsSubCategory[]

  @@index([status])
  @@index([sequence])
  @@map("abs_category")
}

model AbsAuthor {
  authorId            Int            @id @default(autoincrement())
  submissionId        Int?
  title               String         @db.VarChar(255)
  firstName           String         @db.VarChar(200)
  lastName            String?        @db.VarChar(200)
  designation         String?        @db.VarChar(255)
  institution         String?        @db.VarChar(255)
  country             String?        @db.VarChar(200)
  phone               String?        @db.VarChar(15)
  email               String?        @db.VarChar(100)
  isPresentingAuthor  String?        @db.VarChar(10)
  correspondingAuthor String?        @db.VarChar(10)
  status              Int            @default(1)
  createdOn           DateTime       @default(now()) @db.DateTime(0)
  submission          AbsSubmission? @relation(fields: [submissionId], references: [submissionId], map: "fk_abs_author_submission")

  @@index([submissionId])
  @@index([status])
  @@map("abs_author")
}

model abs_scoring {
  scoringId    Int      @id @default(autoincrement())
  submissionId Int
  novelty      String?  @db.VarChar(10)
  relevance    String?  @db.VarChar(10)
  originality  String?  @db.VarChar(10)
  content      String?  @db.VarChar(10)
  totalScore   String?  @db.VarChar(10)
  scoreBy      Int?
  isEval       Int      @default(1) // 1: yes, 0: decline
  reason       String?
  createdOn    DateTime @default(now())

  @@map("abs_scoring") // maps Prisma model to existing MySQL table
}

model Country {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(100)
  code     String @db.VarChar(5)
  sequence Int?
  status   Int    @default(1)

  @@map("countries")
}

model Banner {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  bannerImage String   @db.VarChar(255)
  sequence    Int?
  status      Int      @default(1)
  createdOn   DateTime @default(now()) @db.DateTime(0)

  @@map("banners")
}

model News {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(100)
  description   String   @db.VarChar(10000)
  sequence      Int?
  status        Int      @default(1)
  newsImage     String   @db.VarChar(255)
  createdOn     DateTime @default(now()) @db.DateTime(0)
  eventDate     String?  @db.VarChar(100)
  speakerDetail String?  @db.VarChar(500)
  speakerName   String?  @db.VarChar(255)
  venue         String?  @db.VarChar(255)
  time          String?  @db.VarChar(100)

  @@map("news")
}

model PaymentDetails {
  id                Int      @id @default(autoincrement())
  bankName          String   @db.VarChar(100)
  accountNumber     String   @db.VarChar(100)
  ifscCode          String   @db.VarChar(50)
  accountHolderName String   @db.VarChar(100)
  branch            String   @db.VarChar(100)
  status            Int      @default(1)
  createdOn         DateTime @default(now()) @db.DateTime(0)
  qrcodeImage       String   @db.VarChar(255)

  @@map("payment_details")
}

model PhotoAlbum {
  id         Int          @id @default(autoincrement())
  userId     Int?
  title      String
  thumbnail  String?
  day        String?
  dateTime   String?
  status     Int          @default(1)
  ownerName  String?
  createdOn  DateTime     @default(now())
  albumImage AlbumImage[]
}

model AlbumImage {
  id        Int        @id @default(autoincrement())
  albumId   Int
  path      String
  createdOn DateTime   @default(now())
  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId], map: "AlbumImage_albumId_fkey")
}

model InvitedMember {
  id        Int      @id @default(autoincrement())
  name      String
  ltsino    String?
  email     String?
  nights    Int?     @default(2)
  createdOn DateTime @default(now())
  country   String?
  phone     String?
  photo     String?
  state     String?
  status    Int      @default(1)
  biodata   String?

  @@map("invited_member")
}

model ResponsibilityWork {
  id           Int      @id @default(autoincrement())
  invitedMemId Int
  topic        String?  @db.Text
  role         String
  dateTime     String
  location     String
  title        String   @db.Text
  createdOn    DateTime @default(now())
  genre        String?
  theme        String?

  @@map("responsibilityWork")
}

model Responsibility {
  responsibilityId Int     @id @default(autoincrement())
  responsibility   String?

  @@map("responsibility")
}

model days {
  day_id   Int       @id @default(autoincrement())
  day_name String?   @db.VarChar(200)
  date     DateTime? @db.Date
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model rooms {
  room_id    Int      @id @default(autoincrement())
  room_name  String?  @db.VarChar(255)
  status     Int      @default(0)
  seq        Int
  created_on DateTime @default(now()) @db.DateTime(0)
}
